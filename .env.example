# Required: Groq API key (https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# LLM Models
GROQ_CHAT_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b

# Local STT (faster-whisper on CPU: tiny, base, or small)
WHISPER_MODEL=base
# Hindi turns use a larger model (base writes Hindi in Urdu script). Set to base to disable.
WHISPER_HI_MODEL=small
WHISPER_CPU_THREADS=6

# Voice-call turn taking
VAD_END_OF_TURN_MS=650
VAD_BARGE_IN_MS=400

# Local TTS (Piper ONNX voice models)
PIPER_EN_MODEL=models/piper/en_US-lessac-medium.onnx
PIPER_HI_MODEL=models/piper/hi_IN-rohan-medium.onnx

# Optional: External CRM webhook URL (e.g., HubSpot / Zapier / n8n)
CRM_WEBHOOK_URL=
